NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai_lms_tutor
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
# 1024-dim model — must match your Pinecone index dimension
EMBEDDING_MODEL=Xenova/bge-large-en-v1.5
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=ai-lms-tutor
PINECONE_DIMENSION=1024
MAX_QUERY_LENGTH=1200
MAX_UPLOAD_MB=20
AI_REQUEST_LIMIT_PER_15_MIN=40
LOGIN_LIMIT_PER_15_MIN=8
MAX_UPLOAD_FILES=20
UPLOAD_LIMIT_PER_HOUR=80
EMBED_CONCURRENCY=2
UPSERT_BATCH_SIZE=50
MAX_CHUNKS_PER_MATERIAL=400

# LangSmith (LangChain) Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your_langsmith_api_key_here"
LANGCHAIN_PROJECT="ai-lms-tutor"

{
  "name": "ai-lms-tutor-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "start": "npm --prefix backend run start",
    "check": "node --check api/index.js && node --check backend/src/server.js && node --check backend/src/config/db.js",
    "install:apps": "npm --prefix frontend install && npm --prefix backend install"
  },
  "dependencies": {
    "@langchain/core": "^0.3.29",
    "@langchain/groq": "^0.1.3",
    "@langchain/pinecone": "^0.1.3",
    "@pinecone-database/pinecone": "^3.0.2",
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "langchain": "^0.3.11",
    "mammoth": "^1.9.0",
    "mongoose": "^8.9.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "uuid": "^11.0.3"
  }
}
